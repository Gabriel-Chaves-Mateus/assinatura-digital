# Copie para .env e preencha. NUNCA versione o .env.

NODE_ENV=production
PORT=4000

# MongoDB Atlas (recomendado — risco de segurança do banco transferido ao provedor)
# MONGO_URI=mongodb+srv://USUARIO:SENHA@cluster.mongodb.net/despesas?retryWrites=true&w=majority
# Ou o Mongo local do docker compose (--profile local-db):
MONGO_URI=mongodb://root:TROQUE_ESTA_SENHA@mongo:27017/despesas?authSource=admin
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=TROQUE_ESTA_SENHA

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES=1h

# Origem(ns) do frontend permitidas no CORS (sem barra final)
CORS_ORIGINS=http://localhost:3000,https://SEU_USUARIO.github.io
# URL pública do frontend (links dos e-mails)
APP_URL=https://SEU_USUARIO.github.io/NOME_DO_REPO

# Nodemailer (SMTP). Sem SMTP_HOST os e-mails apenas aparecem no log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Despesas <no-reply@seudominio.com>

# Usado só por "npm run seed" (cria o primeiro gerente)
SEED_MANAGER_EMAIL=gerente@exemplo.com
SEED_MANAGER_PASSWORD=
SEED_EMPLOYEE_PASSWORD=

# Frontend (build)
NEXT_PUBLIC_API_URL=http://localhost:4000
